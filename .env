# =============================================================================
# heroxin-pic 环境变量（可提交 Git：非涉密配置）
# =============================================================================
#
# 用法：
#   1. 直接编辑本文件 → 标题、OSS、上传限制等
#   2. 涉密项仅写在 .env.local（AccessKey 等，已在 .gitignore）
#   3. 修改后重启 pnpm dev
#
# 加载优先级：.env → sts-server/.env（旧位置，兼容）→ .env.local（仅覆盖涉密项）
#
# 变量前缀：
#   - VITE_*           前端可见，会打进浏览器包，勿放长期密钥
#   - ALIBABA_CLOUD_*  仅服务端 STS 使用 → 只写在 .env.local
#
# 文档：docs/sts-setup.md · docs/oss-setup.md · docs/deploy.md
# =============================================================================

# --- 应用展示 ---
VITE_APP_TITLE=阿鑫相册

# 静态资源 / 路由 base（子路径部署时设置，如 /pic/）
# VITE_BASE=/

# --- 阿里云 OSS（前端）---
VITE_OSS_REGION=oss-cn-beijing
VITE_OSS_BUCKET=heroxin
VITE_OSS_ENDPOINT=
VITE_OSS_DIR=file/

# STS 接口：本地 dev 内嵌 /api/sts；生产换成 HTTPS 地址
VITE_STS_URL=/api/sts

# --- 上传限制 ---
# 图片/文档等单文件上限；视频通常更大，见 VITE_MAX_VIDEO_SIZE_MB
VITE_MAX_SIZE_MB=50
VITE_MAX_VIDEO_SIZE_MB=200
VITE_MAX_TOTAL_SIZE_MB=500
VITE_ALLOWED_EXT=jpg,jpeg,png,gif,webp,svg,pdf,doc,docx,txt,md,json,csv,mp4,webm,mov,m4v,mkv,avi,3gp
VITE_DUPLICATE_STRATEGY=uuid
# VITE_ALBUM_THUMB_CONCURRENCY=4
VITE_OSS_THUMB_PROCESS=image/resize,m_lfit,w_480/quality,q_80
# VITE_OSS_VIDEO_SNAPSHOT_PROCESS=video/snapshot,t_0,f_jpg,w_480,m_fast
# VITE_UPLOAD_CONCURRENCY=2

# --- 独立部署 sts-server 时（pnpm dev 内嵌 STS 可忽略）---
# PORT=7001
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 访问口令（仅 .env.local，勿提交）---
# 打开网站时需输入口令；留空则不启用。修改后需重启 pnpm dev / 重新 build
# APP_ACCESS_PASSWORD=你的口令
