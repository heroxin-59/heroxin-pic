# 复制为 .env.local 后填入真实值（.env.local 不会提交到 Git）

# OSS 地域，如 oss-cn-hangzhou
VITE_OSS_REGION=

# Bucket 名称
VITE_OSS_BUCKET=

# 自定义 Endpoint / 域名（可选，留空则使用默认）
VITE_OSS_ENDPOINT=

# 上传目录前缀
VITE_OSS_DIR=uploads/

# STS 临时凭证接口（生产环境推荐；本地调试可暂留空）
VITE_STS_URL=

# —— 仅本地调试（DEV），有 STS 时不必填写；切勿提交真实密钥 ——
# VITE_OSS_ACCESS_KEY_ID=
# VITE_OSS_ACCESS_KEY_SECRET=
# VITE_OSS_STS_TOKEN=

# 单文件大小上限（MB）
VITE_MAX_SIZE_MB=50

# 单次选择/队列总体积上限（MB）
VITE_MAX_TOTAL_SIZE_MB=200

# 允许上传的扩展名，逗号分隔（图片 / PDF / Word / 文本等，见 src/constants/fileTypes.ts）
VITE_ALLOWED_EXT=jpg,jpeg,png,gif,webp,svg,pdf,doc,docx,txt,md,json,csv

# 重名策略：uuid（默认，文件名-UUID.扩展名）| timestamp | overwrite（覆盖）| suffix（自动 -1/-2）
VITE_DUPLICATE_STRATEGY=uuid
