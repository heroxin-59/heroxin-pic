# 复制为 .env.local 后填入真实值（.env.local 不会提交到 Git）
# STS 完整步骤见：docs/sts-setup.md
# 部署与子路径：docs/deploy.md

# 静态资源 / 路由 base（子路径部署时设置，如 /pic/；根路径保持 /）
# 也可仅在构建命令中注入：VITE_BASE=/pic/ pnpm build
# VITE_BASE=/

# OSS 地域，如 oss-cn-hangzhou
VITE_OSS_REGION=

# Bucket 名称
VITE_OSS_BUCKET=

# 自定义 Endpoint / 域名（可选，留空则使用默认）
VITE_OSS_ENDPOINT=

# 上传目录前缀
VITE_OSS_DIR=uploads/

# —— STS 临时凭证（推荐）——
# 本地开发：pnpm dev 已内嵌 STS，配置写在 sts-server/.env 即可
#   VITE_STS_URL=/api/sts
# 生产：换成你的 HTTPS STS 接口（可继续用 sts-server 独立部署）
#   VITE_STS_URL=https://sts.example.com/sts
VITE_STS_URL=/api/sts

# —— 仅本地调试（DEV），有 VITE_STS_URL 时请注释掉 ——
# 长期 Key 勿上线；若手工粘贴临时凭证，三项都要填（含 Token）
# VITE_OSS_ACCESS_KEY_ID=
# VITE_OSS_ACCESS_KEY_SECRET=
# VITE_OSS_STS_TOKEN=

# 单文件大小上限（MB）
VITE_MAX_SIZE_MB=50

# 单次选择/队列总体积上限（MB）
VITE_MAX_TOTAL_SIZE_MB=200

# 允许上传的扩展名，逗号分隔（图片 / PDF / Word / 文本等，见 src/constants/fileTypes.ts）
VITE_ALLOWED_EXT=jpg,jpeg,png,gif,webp,svg,pdf,doc,docx,txt,md,json,csv

# 重名策略：uuid（默认，OSS 存 UUID-文件名；列表/下载显示原名）| timestamp | overwrite | suffix
VITE_DUPLICATE_STRATEGY=uuid

# 相册缩略图并发拉取数（默认 4）
# VITE_ALBUM_THUMB_CONCURRENCY=4

# 相册缩略图 OSS 图片处理（可选；需 Bucket 开通「图片处理」）。留空则拉原图 Blob。
# 示例：image/resize,m_lfit,w_480/quality,q_80
# VITE_OSS_THUMB_PROCESS=
