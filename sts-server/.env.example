# 复制为 .env 后填写（本目录 .env 已 gitignore，勿提交）
# 切勿把真实 AccessKey 写进本文件或提交到 Git

# 有 sts:AssumeRole 权限的 RAM 用户 AccessKey（长期 Key，只放服务端）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# RAM 角色 ARN，形如：acs:ram::<账号ID>:role/heroxin-pic-oss
ALIBABA_CLOUD_ROLE_ARN=acs:ram::<账号ID>:role/heroxin-pic-oss

# 可选：会话名、有效期（秒，900–3600）、监听端口
# ALIBABA_CLOUD_ROLE_SESSION_NAME=heroxin-pic
# ALIBABA_CLOUD_TOKEN_EXPIRE_SECONDS=3600
# PORT=7001

# 可选：进一步收紧临时凭证权限（JSON 字符串）。留空则使用角色上已绑的策略。
# ALIBABA_CLOUD_POLICY={"Version":"1","Statement":[{"Effect":"Allow","Action":["oss:PutObject","oss:GetObject","oss:DeleteObject","oss:ListObjects"],"Resource":["acs:oss:*:*:YOUR_BUCKET/uploads/*","acs:oss:*:*:YOUR_BUCKET"]}]}

# 允许跨域的前端 Origin（逗号分隔；开发默认放行 localhost）
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
